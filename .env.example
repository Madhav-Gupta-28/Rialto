# Copy to .env and fill in. The real .env is gitignored and never committed.
HEDERA_TESTNET_RPC=https://testnet.hashio.io/api
MIRROR_NODE=https://testnet.mirrornode.hedera.com/api/v1
OPERATOR_ADDRESS=
PRIVATE_KEY=

# Asset Tokenization Studio, Hedera testnet (verified 2026-09-03)
ATS_FACTORY=0x00000000000000000000000000000000008c95cf
ATS_RESOLVER=0x00000000000000000000000000000000008c9142

# filled in by the deploy script
MANDATES_ADDRESS=
MARKET_ADDRESS=

# The agent. HCS message submission needs the native SDK, not the EVM, so it
# needs the Hedera account id as well as the key. Leave HCS_TOPIC_ID empty and
# the agent still hashes its reasoning honestly — it just says plainly that
# nothing was timestamped by consensus.
HEDERA_ACCOUNT_ID=
HCS_TOPIC_ID=
POLL_MS=5000
# STRATEGY= optional; overrides the default brief
