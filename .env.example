# Copy to .env and fill in. The real .env is gitignored and never committed.
HEDERA_TESTNET_RPC=https://testnet.hashio.io/api
MIRROR_NODE=https://testnet.mirrornode.hedera.com/api/v1
OPERATOR_ADDRESS=
# The same account as 0.0.x. Only the account-creation helper needs it, because
# that call is native rather than EVM (ARCHITECTURE.md 3.9).
OPERATOR_ACCOUNT_ID=
PRIVATE_KEY=

# Asset Tokenization Studio, Hedera testnet (verified 2026-09-03)
ATS_FACTORY=0xd1F118A40f3b02883D35909eF2517e7EDd78379d
ATS_RESOLVER=0xBA2D5FC2083A0b8f164c50e65d782087fBA18E0a

# filled in by the deploy script
MANDATES_ADDRESS=
# Optional for the agent. Without it the pre-bid recovery check is skipped.
LENS_ADDRESS=
MARKET_ADDRESS=

# The agent. HCS message submission needs the native SDK, not the EVM, so it
# needs the Hedera account id as well as the key. Leave HCS_TOPIC_ID empty and
# the agent still hashes its reasoning honestly — it just says plainly that
# nothing was timestamped by consensus.
HEDERA_ACCOUNT_ID=
HCS_TOPIC_ID=
POLL_MS=5000
# STRATEGY= optional; overrides the default brief

# The reasoner. With a key the agent reads the prospectus with a model. Without
# one it falls back to a regular-expression reader, says so on startup, and
# still produces a valid bid — so the demo never depends on a network call.
# Reading the document is the entire argument for a model being here, so the
# fallback is a fallback and not the intended path.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# An auction has a deadline; a slow underwriter misses it rather than stalling.
REASONER_TIMEOUT_MS=30000

# Demo actors. Distinct keys so borrower, underwriter and agent are genuinely
# different parties rather than one address trading with itself.
BORROWER_KEY=
BORROWER_ADDRESS=
UNDERWRITER_KEY=
UNDERWRITER_ADDRESS=
AGENT_KEY=
AGENT_ADDRESS=
BOND_ADDRESS=
CASH_ADDRESS=
AGENT_ACCOUNT_ID=
